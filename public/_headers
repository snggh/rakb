# Cloudflare Pages / Netlify response headers.
# Cloudflare Pages reads this file from the root of the build output.

/*
  # Stop the browser from guessing a different content type than we sent.
  X-Content-Type-Options: nosniff

  # No one embeds this site in a frame. `frame-ancestors` below is the modern
  # equivalent; X-Frame-Options stays for older browsers.
  X-Frame-Options: DENY

  # Send the origin only, and only over HTTPS.
  Referrer-Policy: strict-origin-when-cross-origin

  # The site needs none of these. Deny them up front.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()

  # HTTPS only, for two years, including subdomains.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Content Security Policy.
  #   script-src keeps 'unsafe-inline': Next's App Router streams its RSC payload
  #     through inline <script> tags whose contents change every build, so a hash
  #     or nonce allowlist is not maintainable on a static export. 'self' still
  #     blocks every external script origin, which is the attack that matters here.
  #   frame-src allows only the Google Maps venue embed.
  #   connect-src 'self' — the site makes no outbound requests at all.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed build assets never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
